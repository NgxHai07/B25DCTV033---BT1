<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Giới Thiệu - Nguyễn Xuân Hải</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #333333;
            --header-bg: #f9f9f9;
            --card-bg: #f4f4f4;
            --primary-color: #A0191B; /* Màu đỏ PTIT */
            --primary-hover: #7c1214;
        }

        body.dark-mode {
            --bg-color: #1a1a1a;
            --text-color: #f0f0f0;
            --header-bg: #2a2a2a;
            --card-bg: #2d2d2d;
            --primary-color: #ff4d4d;
            --primary-hover: #ff1a1a;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s, color 0.3s;
        }

        header {
            background-color: var(--header-bg);
            padding: 20px;
            text-align: center;
            border-bottom: 3px solid var(--primary-color);
        }

        nav {
            background-color: var(--primary-color);
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        main {
            max-width: 800px;
            margin: 30px auto;
            padding: 20px;
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        h1, h2, h3 {
            color: var(--primary-color);
        }

        .info-section {
            margin-top: 20px;
            line-height: 1.6;
        }

        .info-section ul {
            padding-left: 20px;
        }

        .info-section a {
            color: var(--text-color);
            text-decoration: none;
        }
        
        .info-section a:hover {
            color: var(--primary-color);
            text-decoration: underline;
        }

        .btn-container {
            text-align: center;
            margin-top: 30px;
        }

        #toggle-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        #toggle-btn:hover {
            background-color: var(--primary-hover);
        }

        footer {
            text-align: center;
            padding: 15px;
            background-color: var(--header-bg);
            margin-top: 40px;
            border-top: 1px solid #ddd;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <header>
        <h3 id="loi-chao">Đang tải lời chào...</h3>
        <h1>Nguyễn Xuân Hải</h1>
        <p>Mã sinh viên: B25DCTV033</p>
    </header>

    <nav>
        <a href="#">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Học tập</a>
        <a href="#">Liên hệ</a>
    </nav>

    <main>
        <h2>Hồ sơ cá nhân</h2>
        <div class="info-section">
            <p><strong>Ngày sinh:</strong> 10/3/2007</p>
            <p><strong>Đơn vị học tập:</strong> Học viện Công nghệ Bưu Chính Viễn thông (PTIT)</p>
            <p><strong>Khóa học:</strong> Sinh viên năm hai</p>
            
            <h3>Học vấn & Thành tích</h3>
            <ul>
                <li><strong>GPA Học kì 1:</strong> 3.4</li>
                <li><strong>Chứng chỉ ngoại ngữ:</strong> TOEIC 795</li>
            </ul>

            <h3>Thông tin liên hệ</h3>
            <ul>
                <li><strong>Email:</strong> <a href="mailto:hainx.b25tv033@stu.ptit.edu.vn">hainx.b25tv033@stu.ptit.edu.vn</a></li>
                <li><strong>Điện thoại:</strong> <a href="tel:0858103207">0858103207</a></li>
            </ul>
        </div>

        <div class="btn-container">
            <button id="toggle-btn">Đổi màu nền (Chế độ tối)</button>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 - Thiết kế bởi Nguyễn Xuân Hải (B25DCTV033)</p>
    </footer>

    <script>
        // 1. Logic hiển thị lời chào theo thời gian trong ngày
        const gioHienTai = new Date().getHours();
        const phanTuLoiChao = document.getElementById('loi-chao');

        if (gioHienTai < 12) {
            phanTuLoiChao.innerText = 'Chào buổi sáng, chúc bạn một ngày học tập hiệu quả!';
        } else if (gioHienTai < 18) {
            phanTuLoiChao.innerText = 'Chào buổi chiều, chúc bạn tiếp tục làm việc năng suất!';
        } else {
            phanTuLoiChao.innerText = 'Chào buổi tối, chúc bạn buổi tối an lành!';
        }

        // 2. Logic nút bấm chuyển đổi giao diện Sáng / Tối (Dark Mode)
        const body = document.body;
        const btnDoiMau = document.getElementById('toggle-btn');

        btnDoiMau.addEventListener('click', function() {
            body.classList.toggle('dark-mode');
            
            // Đổi nội dung chữ trên nút tùy theo trạng thái
            if (body.classList.contains('dark-mode')) {
                btnDoiMau.innerText = 'Đổi màu nền (Chế độ sáng)';
            } else {
                btnDoiMau.innerText = 'Đổi màu nền (Chế độ tối)';
            }
        });
    </script>

</body>
</html>
